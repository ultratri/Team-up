# TeamUp 生产环境配置模板
# 使用前请复制此文件为 application-prod.yml 并填写实际配置值

server:
  port: 8080
  servlet:
    context-path: /
    session:
      timeout: 7200s  # 2小时会话超时
  compression:
    enabled: true
    mime-types: application/json,application/xml,text/html,text/xml,text/plain

spring:
  application:
    name: teamup-server
    
  # 数据源配置
  datasource:
    url: jdbc:mysql://<DB_HOST>:<DB_PORT>/teamup?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: <DB_USERNAME>
    password: <DB_PASSWORD>
    driver-class-name: com.mysql.cj.jdbc.Driver
    
    # HikariCP 连接池配置
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
      connection-timeout: 30000
      idle-timeout: 600000
      max-lifetime: 1800000
      connection-test-query: SELECT 1
      
  # Redis 配置（可选，用于缓存）
  redis:
    host: <REDIS_HOST>
    port: <REDIS_PORT>
    password: <REDIS_PASSWORD>
    database: 0
    timeout: 5000ms
    lettuce:
      pool:
        max-active: 20
        max-idle: 10
        min-idle: 5
        max-wait: 2000ms
        
  # 缓存配置
  cache:
    type: redis
    redis:
      time-to-live: 300000  # 5分钟
      cache-null-values: false
      key-prefix: "teamup:cache:"
      
  # 会话配置
  session:
    store-type: redis
    timeout: 7200s
    redis:
      namespace: "teamup:session"
      
  # 文件上传配置
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 20MB
      
# MyBatis Plus 配置
mybatis-plus:
  configuration:
    # 生产环境关闭 SQL 日志
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
    map-underscore-to-camel-case: true
    cache-enabled: true
  global-config:
    db-config:
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
      
# 日志配置
logging:
  level:
    root: INFO
    com.teamup.server: INFO
    com.teamup.server.modules.user: INFO
    org.springframework.web: WARN
    org.mybatis: WARN
  file:
    name: logs/teamup-server.log
    max-size: 50MB
    max-history: 30
    total-size-cap: 1GB
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
    file: "%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n"
    
# Actuator 监控配置
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics,prometheus
      base-path: /actuator
  endpoint:
    health:
      show-details: when-authorized
  metrics:
    export:
      prometheus:
        enabled: true
        
# 人才墙功能配置
talent-wall:
  # 分页配置
  max-page-size: 100
  default-page-size: 12
  
  # 搜索配置
  min-keyword-length: 2
  max-keyword-length: 50
  
  # 缓存配置
  cache-enabled: true
  cache-ttl: 300  # 5分钟
  
  # 性能配置
  query-timeout: 5000  # 5秒查询超时
  
# CORS 配置
cors:
  allowed-origins: 
    - https://your-domain.com
    - https://www.your-domain.com
  allowed-methods:
    - GET
    - POST
    - PUT
    - DELETE
    - OPTIONS
  allowed-headers:
    - "*"
  allow-credentials: true
  max-age: 3600
  
# 安全配置
security:
  # 密码加密强度
  password-encoder-strength: 10
  
  # 会话固定保护
  session-fixation-protection: migrateSession
  
  # CSRF 保护
  csrf-enabled: true
  
# 审计日志配置
audit:
  enabled: true
  retention-days: 90
  sensitive-operations:
    - UPDATE_AVAILABILITY
    - VIEW_TALENT_DETAIL
    
# 性能监控配置
performance:
  slow-query-threshold: 1000  # 慢查询阈值（毫秒）
  slow-request-threshold: 2000  # 慢请求阈值（毫秒）
