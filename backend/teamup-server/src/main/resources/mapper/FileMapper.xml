<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.teamup.server.modules.file.mapper.FileMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.teamup.server.modules.file.entity.FileEntity">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="team_id" property="teamId" jdbcType="BIGINT"/>
        <result column="uploader_id" property="uploaderId" jdbcType="BIGINT"/>
        <result column="file_name" property="fileName" jdbcType="VARCHAR"/>
        <result column="file_path" property="filePath" jdbcType="VARCHAR"/>
        <result column="file_size" property="fileSize" jdbcType="BIGINT"/>
        <result column="file_type" property="fileType" jdbcType="VARCHAR"/>
        <result column="mime_type" property="mimeType" jdbcType="VARCHAR"/>
        <result column="folder_path" property="folderPath" jdbcType="VARCHAR"/>
        <result column="version" property="version" jdbcType="INTEGER"/>
        <result column="parent_file_id" property="parentFileId" jdbcType="BIGINT"/>
        <result column="is_folder" property="isFolder" jdbcType="BOOLEAN"/>
        <result column="parent_folder_id" property="parentFolderId" jdbcType="BIGINT"/>
        <result column="uploaded_at" property="uploadedAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, team_id, uploader_id, file_name, file_path, file_size, file_type, mime_type,
        folder_path, version, parent_file_id, is_folder, parent_folder_id, uploaded_at
    </sql>

    <!-- 根据团队ID和父文件夹ID查询文件列表 -->
    <select id="selectByTeamAndFolder" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM files
        WHERE team_id = #{teamId}
        <choose>
            <when test="parentFolderId != null">
                AND parent_folder_id = #{parentFolderId}
            </when>
            <otherwise>
                AND parent_folder_id IS NULL
            </otherwise>
        </choose>
        ORDER BY is_folder DESC, uploaded_at DESC
    </select>

    <!-- 根据团队ID统计文件数量（不包括文件夹） -->
    <select id="countFilesByTeamId" resultType="int">
        SELECT COUNT(*)
        FROM files
        WHERE team_id = #{teamId}
          AND is_folder = FALSE
    </select>

    <!-- 递归查询文件夹下的所有文件和子文件夹 -->
    <select id="selectAllFilesInFolder" resultMap="BaseResultMap">
        WITH RECURSIVE folder_tree AS (
            SELECT
            <include refid="Base_Column_List"/>
            FROM files
            WHERE id = #{folderId}
            UNION ALL
            SELECT f.id, f.team_id, f.uploader_id, f.file_name, f.file_path, f.file_size,
                   f.file_type, f.mime_type, f.folder_path, f.version, f.parent_file_id,
                   f.is_folder, f.parent_folder_id, f.uploaded_at
            FROM files f
                     INNER JOIN folder_tree ft ON f.parent_folder_id = ft.id
        )
        SELECT
        <include refid="Base_Column_List"/>
        FROM folder_tree
        WHERE id != #{folderId}
    </select>

</mapper>
